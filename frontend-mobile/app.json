{
  "expo": {
    "name": "Smart Attendance",
    "slug": "smart-attendance",
    "version": "1.0.0",
    "scheme": "smart-attendance",
    "platforms": [
      "android"
    ],
    "icon": "./assets/adaptive-icon.png",
    "android": {
      "package": "com.smartattendance.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5F3EF"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "enableProguardInProductionBuilds": true,
      "enableShrinkResourcesInProductionBuilds": true
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "This app needs camera access to scan your iris for attendance."
        }
      ],
      "expo-router"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "88ba0117-8966-44e6-b6ce-1d8301f1d800"
      }
    },
    "owner": "abdul-moiz"
  }
}
